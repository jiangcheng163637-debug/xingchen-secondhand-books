.search-page { padding-top: 20rpx; }
.search-bar { display: flex; align-items: center; }
.input-wrap { position: relative; display: flex; align-items: center; flex: 1; min-height: 88rpx; padding: 0 28rpx; overflow: hidden; background: #F9F7F2; border-bottom: 2rpx solid #2C425B; }
.input-wrap input { flex: 1; min-width: 0; }
.search-icon { position: relative; flex: none; width: 28rpx; height: 28rpx; margin-right: 20rpx; border: 4rpx solid #2C425B; border-radius: 50%; }
.search-icon::after { content: ""; position: absolute; right: -12rpx; bottom: -8rpx; width: 16rpx; height: 4rpx; background: #2C425B; transform: rotate(45deg); }
.focus-bookmark { position: absolute; top: 0; right: 16rpx; width: 16rpx; height: 30rpx; background: #C85A5A; }
.focus-bookmark::after { content: ""; position: absolute; bottom: 0; border-right: 8rpx solid transparent; border-bottom: 7rpx solid #F9F7F2; border-left: 8rpx solid transparent; }
.cancel { flex: none; min-width: 104rpx; padding: 0 0 0 20rpx; color: #2C425B; background: transparent; }
.history { margin-top: 44rpx; padding: 24rpx; background: rgba(232, 217, 195, .34); border-radius: 12rpx; }
.history-head { display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 700; }
.clear { color: #666666; font-size: 23rpx; font-weight: 400; }
.history .ink-rule { margin-top: 14rpx; }
.tags { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.tag { position: relative; margin: 0 14rpx 14rpx 0; padding: 12rpx 24rpx 12rpx 16rpx; color: #2C425B; background: #E8D9C3; font-size: 24rpx; }
.tag::after { content: ""; position: absolute; top: 0; right: 0; border-top: 18rpx solid #F9F7F2; border-left: 12rpx solid transparent; }
.results { animation: result-turn-in 240ms ease-out both; }
.result-title { display: flex; align-items: center; margin: 32rpx 0 20rpx; color: #666666; font-size: 23rpx; }
.title-line { flex: 1; height: 2rpx; margin-left: 16rpx; background: rgba(44, 66, 91, .28); }
.book-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx 16rpx; }
.search-prompt { display: flex; flex-direction: column; align-items: center; padding: 150rpx 32rpx 40rpx; color: #666666; text-align: center; font-size: 24rpx; }
.prompt-book { position: relative; width: 120rpx; height: 96rpx; margin-bottom: 28rpx; }
.prompt-book view { position: absolute; top: 0; width: 60rpx; height: 78rpx; background: #E8D9C3; border: 2rpx solid #2C425B; }
.prompt-book view:first-child { left: 0; border-radius: 12rpx 2rpx 2rpx 12rpx; transform: rotate(4deg); }
.prompt-book view:nth-child(2) { right: 0; border-radius: 2rpx 12rpx 12rpx 2rpx; transform: rotate(-4deg); }
.prompt-book text { position: absolute; top: 22rpx; left: 48rpx; z-index: 2; color: #C85A5A; font-size: 32rpx; font-weight: 700; }
.prompt-big { margin-bottom: 12rpx; color: #222222; font-size: 40rpx; font-weight: 700; }
@keyframes result-turn-in { from { opacity: 0; transform: translateX(18rpx); } to { opacity: 1; transform: translateX(0); } }
