.mine { padding-top: 20rpx; padding-bottom: 48rpx; }
.profile { position: relative; display: flex; flex-direction: column; align-items: center; min-height: 348rpx; padding: 44rpx 30rpx 36rpx; overflow: hidden; color: #F9F7F2; background: #2C425B; border-radius: 12rpx; box-shadow: 8rpx 10rpx 0 rgba(232, 217, 195, .84); }
.profile-spine { position: absolute; top: 0; bottom: 0; left: 18rpx; width: 6rpx; background: #C85A5A; }
.stamp { position: absolute; top: 20rpx; left: 40rpx; color: #E8D9C3; font-size: 18rpx; letter-spacing: 6rpx; }
.avatar-button { display: flex; align-items: center; justify-content: center; width: 124rpx; height: 148rpx; margin-top: 6rpx; padding: 0; overflow: hidden; color: #2C425B; background: #E8D9C3; border: 4rpx double #F9F7F2; border-radius: 12rpx; font-size: 48rpx; line-height: 1; }
.avatar-button image { width: 100%; height: 100%; }
.nickname { width: 360rpx; height: 62rpx; margin-top: 8rpx; color: #F9F7F2; text-align: center; font-size: 34rpx; font-weight: 700; }
.school { color: #E8D9C3; font-size: 22rpx; }
.edit { min-height: 68rpx; margin-top: 16rpx; padding: 0 26rpx; color: #F9F7F2; background: rgba(249, 247, 242, .08); border: 2rpx solid rgba(249, 247, 242, .36); font-size: 22rpx; line-height: 64rpx; }
.profile-books { position: absolute; right: 26rpx; bottom: 24rpx; width: 70rpx; height: 70rpx; opacity: .56; }
.profile-books view { position: absolute; right: 0; width: 66rpx; height: 14rpx; border: 2rpx solid #F9F7F2; }
.profile-books view:nth-child(1) { bottom: 0; background: #C85A5A; transform: rotate(-4deg); }
.profile-books view:nth-child(2) { bottom: 20rpx; width: 58rpx; background: #E8D9C3; transform: rotate(4deg); }
.profile-books view:nth-child(3) { bottom: 40rpx; width: 64rpx; background: #2C425B; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 24rpx 0 32rpx; padding: 24rpx 0; background: rgba(232, 217, 195, .38); border: 2rpx solid rgba(44, 66, 91, .2); border-radius: 12rpx; }
.stats view { display: flex; flex-direction: column; align-items: center; border-right: 2rpx solid rgba(44, 66, 91, .2); }
.stats view:last-child { border-right: 0; }
.stats .stat-number { margin: 0; color: #2C425B; font-size: 38rpx; font-weight: 700; }
.stats text { margin-top: 4rpx; color: #666666; font-size: 21rpx; }
.menu-title { display: flex; align-items: center; margin-bottom: 12rpx; font-size: 30rpx; font-weight: 700; }
.menu-title view { flex: 1; height: 2rpx; margin-left: 16rpx; background: rgba(44, 66, 91, .28); }
.support-title { margin-top: 32rpx; }
.menu { padding: 0 20rpx; background: #F9F7F2; border: 2rpx solid rgba(44, 66, 91, .24); border-radius: 12rpx; box-shadow: 5rpx 7rpx 0 rgba(232, 217, 195, .64); }
.menu > view { display: flex; align-items: center; min-height: 98rpx; border-bottom: 2rpx solid rgba(44, 66, 91, .18); }
.menu > view:last-child { border-bottom: 0; }
.book-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 58rpx; margin-right: 18rpx; color: #F9F7F2; background: #2C425B; border-radius: 2rpx 8rpx 8rpx 2rpx; font-size: 20rpx; }
.book-mark::before { content: ""; position: absolute; top: 0; bottom: 0; left: 6rpx; width: 2rpx; background: rgba(249, 247, 242, .56); }
.book-mark.red { background: #C85A5A; }
.book-mark.kraft { color: #2C425B; background: #E8D9C3; border: 2rpx solid #2C425B; }
.arrow { width: 18rpx; height: 18rpx; margin-left: auto; border-top: 2rpx solid #2C425B; border-right: 2rpx solid #2C425B; transform: rotate(45deg); }
.boundary { padding: 38rpx 10rpx 0; color: #666666; font-size: 20rpx; text-align: center; }
.boundary-rule { width: 96rpx; height: 2rpx; margin: 0 auto 14rpx; background: #2C425B; opacity: .38; }
