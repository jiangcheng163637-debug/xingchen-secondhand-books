{
  "pages": [
    "pages/index/index",
    "pages/publish/publish",
    "pages/mine/mine",
    "pages/detail/detail",
    "pages/search/search"
  ],
  "subPackages": [
    {
      "root": "subpackages/account",
      "name": "account",
      "pages": ["pages/my-list/my-list", "pages/history/history", "pages/profile/profile"]
    },
    {
      "root": "subpackages/support",
      "name": "support",
      "pages": ["pages/about/about", "pages/feedback/feedback", "pages/report/report"]
    }
  ],
  "preloadRule": {
    "pages/mine/mine": { "network": "all", "packages": ["account"] },
    "pages/detail/detail": { "network": "wifi", "packages": ["support"] }
  },
  "window": {
    "navigationBarTitleText": "星辰二手书",
    "navigationBarBackgroundColor": "#F9F7F2",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F9F7F2",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#666666",
    "selectedColor": "#2C425B",
    "backgroundColor": "#F9F7F2",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/publish/publish", "text": "发布" },
      { "pagePath": "pages/mine/mine", "text": "书架" }
    ]
  },
  "lazyCodeLoading": "requiredComponents",
  "requiredPrivateInfos": [],
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
