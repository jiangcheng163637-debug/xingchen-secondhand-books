.about { padding-bottom: 64rpx; }
.mast { position: relative; min-height: 384rpx; padding: 38rpx 36rpx 38rpx 170rpx; overflow: hidden; color: #F9F7F2; background: #2C425B; border-radius: 12rpx; box-shadow: 8rpx 10rpx 0 rgba(232, 217, 195, .82); }
.mast-spine { position: absolute; top: 0; bottom: 0; left: 18rpx; width: 7rpx; background: #C85A5A; }
.cover-seal { position: absolute; top: 44rpx; left: 48rpx; display: flex; align-items: center; justify-content: center; width: 84rpx; height: 104rpx; color: #F9F7F2; background: #C85A5A; border: 4rpx double #F9F7F2; font-size: 24rpx; font-weight: 700; }
.title { display: block; margin-top: 36rpx; font-size: 48rpx; font-weight: 700; line-height: 1.35; }
.mast-rule { width: 100rpx; height: 2rpx; margin-top: 32rpx; background: #E8D9C3; }
.edition { display: block; margin-top: 16rpx; color: #E8D9C3; font-size: 22rpx; }
.story { margin-top: 32rpx; border-top: 2rpx solid rgba(44, 66, 91, .3); }
.chapter { display: flex; padding: 30rpx 8rpx; border-bottom: 2rpx solid rgba(44, 66, 91, .26); color: #222222; line-height: 48rpx; }
.chapter-number { display: flex; align-items: center; justify-content: center; flex: none; width: 52rpx; height: 64rpx; margin-right: 20rpx; color: #F9F7F2; background: #C85A5A; font-size: 24rpx; }
.chapter > view { flex: 1; }
.chapter > view > text { display: block; }
.heading { margin-bottom: 10rpx; color: #2C425B; font-size: 32rpx; font-weight: 700; }
.safety { width: 100%; margin-top: 32rpx; color: #2C425B; background: rgba(232, 217, 195, .52); border: 2rpx solid rgba(44, 66, 91, .32); }
