.my-list-page { padding-bottom: 48rpx; }
.page-heading { display: flex; align-items: center; margin: 8rpx 0 20rpx; color: #222222; font-size: 36rpx; font-weight: 700; }
.page-heading view { flex: 1; height: 2rpx; margin-left: 18rpx; background: rgba(44, 66, 91, .3); }
.item { display: flex; align-items: center; min-height: 224rpx; margin-bottom: 16rpx; padding: 16rpx; background: #F9F7F2; border: 2rpx solid rgba(44, 66, 91, .24); border-radius: 12rpx; box-shadow: 4rpx 6rpx 0 rgba(232, 217, 195, .7); transition: transform 120ms ease-out, box-shadow 120ms ease-out; }
.item--pressed { transform: translateY(4rpx); box-shadow: 2rpx 2rpx 0 rgba(232, 217, 195, .7); }
.cover-frame { position: relative; flex: none; width: 136rpx; height: 170rpx; overflow: hidden; background: #E8D9C3; border: 2rpx solid #2C425B; border-radius: 12rpx; }
.cover-frame image, .cover-placeholder { width: 100%; height: 100%; }
.cover-placeholder { position: relative; display: flex; align-items: center; justify-content: center; color: #2C425B; font-size: 48rpx; font-weight: 700; }
.spine { position: absolute; top: 0; bottom: 0; left: 12rpx; width: 4rpx; background: #2C425B; }
.copy { position: relative; display: flex; flex: 1; flex-direction: column; align-self: stretch; min-width: 0; padding: 8rpx 14rpx; }
.title { display: -webkit-box; overflow: hidden; color: #222222; font-size: 27rpx; font-weight: 700; line-height: 38rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.meta { margin-top: 8rpx; color: #666666; font-size: 20rpx; }
.price { margin-top: auto; color: #C85A5A; font-size: 30rpx; font-weight: 700; }
.status-tag { position: absolute; right: 4rpx; bottom: 6rpx; padding: 3rpx 18rpx 3rpx 10rpx; color: #F9F7F2; background: #C85A5A; font-size: 18rpx; }
.status-tag::after { content: ""; position: absolute; top: 0; right: 0; border-top: 18rpx solid transparent; border-right: 9rpx solid #F9F7F2; border-bottom: 18rpx solid transparent; }
.actions { display: flex; flex: none; flex-direction: column; justify-content: center; width: 126rpx; }
.actions button { width: 100%; min-height: 72rpx; margin-top: 10rpx; padding: 0 8rpx; color: #2C425B; background: rgba(232, 217, 195, .52); border: 2rpx solid rgba(44, 66, 91, .26); font-size: 20rpx; line-height: 68rpx; }
.actions button:first-child { margin-top: 0; }
.actions .remove-favorite, .actions .offline { color: #C85A5A; background: transparent; border-color: rgba(200, 90, 90, .48); }
